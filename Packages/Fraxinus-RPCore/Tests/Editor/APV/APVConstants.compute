#pragma kernel ReadConstants
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/Runtime/Lighting/ProbeVolume/ProbeVolume.hlsl"

RWStructuredBuffer<float4> _Result;
[numthreads(1, 1, 1)]
void ReadConstants(uint3 id : SV_DispatchThreadID)
{
    _Result[0] = float4(_APVWorldOffset, _APVWeight);
    _Result[1] = float4(_APVSkyOcclusionWeight, _APVSkyDirectionWeight, _APVFrameIndex, _APVLayerCount);
}
